# Database (local Postgres)
DB_URL=jdbc:postgresql://localhost:5432/xclone
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Neon: use the POOLED host (note "-pooler") for the app and the DIRECT host for migrations, both with sslmode=require.
# DB_URL=jdbc:postgresql://ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DB_USER=neondb_owner
# DB_PASSWORD=
# MIGRATION_DB_URL=jdbc:postgresql://ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require

# JWT (REQUIRED: the app will not start without it; must be >= 32 bytes)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare R2 (step by step in the README, section Cloudflare R2 setup). Set these in your run configuration or host, not in a committed file.
# Check them afterwards as an admin: Settings > Image storage > Check image storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=xclone-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_PRESIGN_TTL=10m
R2_MAX_IMAGE_BYTES=5242880
# Only for another S3-compatible server (a local MinIO); leave empty for Cloudflare R2.
# R2_ENDPOINT=

# Email links (verify / reset password) point at the frontend; set SPRING_MAIL_HOST (+ _PORT/_USERNAME/_PASSWORD) to send real mail
FRONTEND_URL=http://localhost:5173
MAIL_FROM=no-reply@xclone.local

# Redis (rate limiting, caching, counters). Upstash: use the rediss:// (TLS) URL from the console.
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# How long the trending list is reused from Redis before it is recomputed (0 = off)
# TRENDING_CACHE_TTL=30s

# Rate limiting (needs Redis). Behind a trusted proxy/load balancer set FORWARD_HEADERS_STRATEGY=framework.
RATE_LIMIT_ENABLED=true
# FORWARD_HEADERS_STRATEGY=framework

# Flyway: set true once to adopt a database that already has the full schema from the old ddl-auto setup. Keep false for new/empty DBs (e.g. a fresh Neon database).
FLYWAY_BASELINE_ON_MIGRATE=false

# WebSocket push relay through Redis (needed when running more than one instance; harmless otherwise)
WS_REDIS_RELAY=true

# Seconds an account is remembered as ACTIVE by the auth filter (saves a DB round trip per request). Deactivation is immediate on the
# instance that handled it and takes up to this long on others. 0 checks the database every time.
ACTIVE_USER_CACHE_TTL=10s

# Email: with SPRING_MAIL_HOST unset the app only logs each email (what tests and CI use). To send real mail with Gmail, create an App Password
# (see README, section Email) and set these in your run configuration or host, NOT in a file you commit:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your.address@gmail.com
# SPRING_MAIL_PASSWORD=<16-character App Password>
# MAIL_FROM=your.address@gmail.com
# Production: your transactional provider's SMTP host, port and login, and a sender on your own domain, e.g. MAIL_FROM=noreply@yourdomain.com
